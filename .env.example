# Google Gemini (required)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini/gemini-3.8-flash

# Retry / fallback models for transient 503 / retired-model errors
GEMINI_FALLBACK_MODEL=gemini/gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini/gemini-3.5-flash-lite,gemini/gemini-flash-lite-latest
GEMINI_FALLBACK_RETRIES=2
GEMINI_RETRY_DELAY_SECONDS=2

# Performance / agent behavior tuning
GEMINI_THINKING_BUDGET=0
GEMINI_INCLUDE_THOUGHTS=false
AGENT_MEMORY_ENABLED=false
AGENT_MAX_ITER=12
CREW_VERBOSE=true
MAX_JOB_TEXT_CHARS=6000
MAX_RESUME_CHARS=12000

# USAJobs (required for USA job search)
USAJOBS_API_KEY=your_usajobs_api_key_here
USAJOBS_EMAIL=your_email@example.com

# Indian job search: adzuna | jsearch | jooble
INDIAN_JOB_PROVIDER=adzuna

# Adzuna (required when INDIAN_JOB_PROVIDER=adzuna)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# JSearch via RapidAPI (required when INDIAN_JOB_PROVIDER=jsearch)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_JSEARCH_HOST=jsearch.p.rapidapi.com

# Jooble (required when INDIAN_JOB_PROVIDER=jooble)
JOOBLE_API_KEY=your_jooble_api_key_here
